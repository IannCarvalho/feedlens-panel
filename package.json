{
  "name": "feedlens-panel",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Interface do FeedLens em Vue 3 + Vite + PrimeVue (TypeScript).",
  "scripts": {
    "dev": "vite",
    "gen:api": "node scripts/gen-api-types.mjs",
    "build": "vue-tsc --build --force && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build --force",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@primeuix/themes": "^1.1.1",
    "chart.js": "^4.6.1",
    "pinia": "^2.3.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.2.5",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "jiti": "^2.7.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.4.2",
    "typescript": "~5.8.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
